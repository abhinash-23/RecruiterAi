# =============================================================================
# nginx for the RecruiterAI SPA
# =============================================================================
# `${...}` is substituted by the nginx image's entrypoint when the container
# starts (it runs `envsubst` over /etc/nginx/templates/*.template), which is
# what makes the port and the API target runtime settings rather than baked-in
# ones. Only names that exist in the environment are substituted, so nginx's own
# `$uri`, `$scheme` and friends below are left alone.
# =============================================================================

# A WebSocket handshake must be answered with `Connection: upgrade`, but an
# ordinary request must not be — echoing it unconditionally breaks keep-alive
# for every normal call. This maps one to the other, and has to live out here
# because `map` is only legal at `http` level (which is where `conf.d/*.conf`
# is included from).
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# The protocol the *client* used, which is not the one this server sees.
#
# Cloud Run terminates TLS at its edge and forwards plain HTTP, so `$scheme` is
# always "http" in here. Passing that on as X-Forwarded-Proto tells the backend
# the session is insecure — and any absolute URL it builds from it comes back as
# `http://`, which an HTTPS page then blocks as mixed content. That is exactly
# the shape of the URLs this app renders: profile pictures and company logos.
map $http_x_forwarded_proto $client_proto {
    default $http_x_forwarded_proto;
    ''      $scheme;
}

server {
    # **Cloud Run assigns this.** The platform sets `PORT` in the environment
    # and routes to whatever the container listens on; a hard-coded port is the
    # single most common reason a revision never becomes ready.
    listen       ${PORT};
    server_name  _;

    root  /usr/share/nginx/html;
    index index.html;

    # Don't advertise the exact nginx build. It tells an attacker which CVEs to
    # try and tells a legitimate visitor nothing.
    server_tokens off;

    include /etc/nginx/snippets/security-headers.conf;

    gzip              on;
    gzip_vary         on;
    gzip_min_length   1024;
    gzip_proxied      any;
    # `text/javascript` as well as `application/javascript`: which of the two an
    # extension maps to has changed between nginx releases, and a bundle this
    # size silently served uncompressed is a megabyte on every first visit.
    gzip_types        text/plain text/css
                      application/javascript text/javascript
                      application/json image/svg+xml application/wasm
                      font/ttf font/otf;

    # -------------------------------------------------------------------------
    # The API
    # -------------------------------------------------------------------------
    # Declared *before* the SPA fallback: without it a request to a path the
    # backend owns would be answered with index.html and a 200, so a failed API
    # call would surface as "unexpected token '<'" rather than as an error.
    location ~ ^/api/(?<api_path>.*)$ {
        # Resolved per request, not once at boot — see `10-resolver.envsh`.
        resolver ${NGINX_RESOLVER} valid=30s ipv6=off;

        # The target goes through a variable *deliberately*. With a literal,
        # nginx resolves it while loading the config and refuses to start if it
        # can't — so an unset or briefly-unreachable backend would take the
        # whole site down instead of just its API calls. This way the app still
        # serves and `/api` returns 502, which is both survivable and legible.
        #
        # A variable also means nginx no longer appends the matched path for us,
        # which is why `api_path` and the query string are spelt out. The result
        # maps `/api/x?y` to `<target>/api/x?y` — no rewrite, exactly as the dev
        # proxy behaves.
        set $api_upstream "${API_PROXY_TARGET}";
        proxy_pass $api_upstream/api/$api_path$is_args$args;

        # What `changeOrigin: true` does in the dev proxy: present the target's
        # own hostname. A tunnel or a vhost routes on Host, and forwarding this
        # server's name would reach the wrong backend — or nothing.
        proxy_set_header Host              $proxy_host;
        proxy_ssl_server_name on;

        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        # The client's protocol, not this server's — see the map above.
        proxy_set_header X-Forwarded-Proto $client_proto;

        # Free ngrok tunnels answer anything browser-shaped with an HTML warning
        # page. This asks for the real response, exactly as the dev proxy does.
        proxy_set_header ngrok-skip-browser-warning "true";

        # Live viewing signals over `WS /api/live/{id}`. Without the upgrade
        # headers nginx answers the handshake as an ordinary request and the
        # socket never opens.
        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # Interview generation runs for the better part of a minute on
        # `verify-otp`, and the default 60s would cut it off mid-flight. Keep
        # Cloud Run's own request timeout at or above this, or it will cut the
        # connection first whatever nginx is willing to wait for.
        proxy_read_timeout  300s;
        proxy_send_timeout  300s;

        # Résumé PDFs and base64 audio go up through here.
        client_max_body_size 25m;

        # Streamed responses shouldn't be held back waiting for a full buffer.
        proxy_buffering off;
    }

    # -------------------------------------------------------------------------
    # Build output — fingerprinted, cached forever
    # -------------------------------------------------------------------------
    # Vite fingerprints these filenames, so a changed file is a changed URL and
    # a year is safe. `immutable` also stops the revalidation request a normal
    # long max-age still makes on reload.
    #
    # `^~`, not a plain prefix: it has to beat the extension regex below, which
    # would otherwise capture the fonts in here and cut their year to an hour.
    #
    # One `add_header`, not `expires 1y` as well — the two each emit their own
    # `Cache-Control`, and a response carrying two of them is ambiguous.
    location ^~ /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # -------------------------------------------------------------------------
    # Files from `public/` — *not* fingerprinted
    # -------------------------------------------------------------------------
    # The landing page's imagery and the demo video live here: about 10 MB
    # served to every first-time visitor, and until now with no cache policy at
    # all, so each one cost a revalidation round trip on every page load.
    #
    # An hour, not a year, and this is the reason why: these names never change,
    # so a long cache would pin a replaced image in visitors' browsers with no
    # way to evict it. An hour is long enough to save the round trips within a
    # session and short enough that a swapped file is picked up the same day.
    location ~* \.(?:png|jpe?g|gif|webp|avif|svg|ico|mp4|webm|woff2?|txt)$ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=3600";
        try_files $uri =404;
    }

    # -------------------------------------------------------------------------
    # The app
    # -------------------------------------------------------------------------
    # `BrowserRouter`, not hash routing — the routes are real paths. A deep link
    # to /admin/jobs or an invitation opening /otp is a request nginx has no
    # file for, and must be answered with index.html so the router can resolve
    # it client-side. Without this, every link into the app 404s on refresh.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # index.html must always be revalidated: it names the fingerprinted bundles,
    # so a stale copy points a returning visitor at files that no longer exist.
    #
    # `no-cache` means "keep it, but check before reusing" — which is what's
    # wanted. Not `no-store`, which forbids keeping it at all and takes the
    # back/forward cache down with it, making every Back press a full reload of
    # a page the browser already had.
    location = /index.html {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache";
    }
}
